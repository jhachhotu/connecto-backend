# Connecto Backend Environment Variables

# Application
PROJECT_NAME="Connecto API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-jwt-key-replace-in-production-min-32-chars-long"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM="HS256"

# CORS Origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://*.run.app"]

# Supabase PostgreSQL Connection String
# For Supabase Pooler:
# Transaction Mode (port 6543) - Recommended for serverless / pooled connections:
# e.g.: postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Direct / Session Mode (port 5432):
# e.g.: postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/connecto"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/connecto"

# Set to True when using Supabase PgBouncer / Transaction pooler (port 6543)
# This disables prepared statement caching which is required for PgBouncer transaction mode
SUPABASE_TRANSACTION_POOLER=True

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Payment Gateways
# Razorpay Configuration (INR payments, UPI, NetBanking, Cards, Wallets)
# Use test keys for development, live keys for production
# Get your credentials from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID="rzp_test_samplekey123"
RAZORPAY_KEY_SECRET="rzp_test_samplesecret456"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_789"

# Emergency SOS SMS/Notification Gateway (Twilio / Fast2SMS placeholder)
SMS_GATEWAY_API_KEY="sample_sms_key"
EMERGENCY_DISPATCH_PHONE="+911122334455"
